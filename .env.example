# Copy to `.env.local` and fill in. `.env*` is gitignored — never commit real keys.

# Resend API key, used by the contact form Server Action.
# Create one at https://resend.com/api-keys
# If unset, the form degrades gracefully: it still validates input and returns a
# friendly "not configured yet" message instead of throwing, so neither the
# build nor the rest of the site is affected.
RESEND_API_KEY=

# Verified sender address for outgoing contact-form mail.
# Must be on a domain verified in Resend, otherwise sending is rejected.
# Example: contact@shztech.dev
CONTACT_FROM_EMAIL=
